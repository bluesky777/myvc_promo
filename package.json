{
	"name": "myvc-promo",
	"version": "1.0.0",
	"private": true,
	"description": "Animaciones cortas de MyVC para el vídeo promocional. Remotion: el clip se genera desde el código.",
	"scripts": {
		"studio": "remotion studio",
		"notas": "remotion render Notas-Aro out/sin-rotulo/notas-aro.mp4",
		"notas-rotulo": "remotion render Notas-Aro-Rotulo out/notas-aro-rotulo.mp4",
		"notas-alfa": "remotion render Notas-Aro out/sin-rotulo/notas-aro.mov --codec=prores --prores-profile=4444 --image-format=png",
		"rubricas": "remotion render Rubricas out/sin-rotulo/rubricas.mp4",
		"rubricas-rotulo": "remotion render Rubricas-Rotulo out/rubricas-rotulo.mp4",
		"todo": "npm run notas && npm run notas-rotulo && npm run rubricas && npm run rubricas-rotulo && npm run combinado && npm run combinado-rotulo && npm run disciplina && npm run disciplina-rotulo && npm run horarios && npm run horarios-rotulo && npm run movil && npm run movil-rotulo",
		"combinado": "remotion render Notas-Y-Rubricas out/sin-rotulo/notas-y-rubricas.mp4",
		"combinado-rotulo": "remotion render Notas-Y-Rubricas-Rotulo out/notas-y-rubricas-rotulo.mp4",
		"disciplina": "remotion render Disciplina out/sin-rotulo/disciplina.mp4",
		"disciplina-rotulo": "remotion render Disciplina-Rotulo out/disciplina-rotulo.mp4",
		"horarios": "remotion render Horarios out/sin-rotulo/horarios.mp4",
		"horarios-rotulo": "remotion render Horarios-Rotulo out/horarios-rotulo.mp4",
		"movil": "remotion render Movil out/sin-rotulo/movil.mp4",
		"movil-rotulo": "remotion render Movil-Rotulo out/movil-rotulo.mp4",
		"ucn-comunicados": "remotion render UCN-Comunicados out/sin-rotulo/ucn-comunicados.mp4",
		"ucn-comunicados-rotulo": "remotion render UCN-Comunicados-Rotulo out/ucn-comunicados-rotulo.mp4",
		"ucn-encuestas": "remotion render UCN-Encuestas out/sin-rotulo/ucn-encuestas.mp4",
		"ucn-encuestas-rotulo": "remotion render UCN-Encuestas-Rotulo out/ucn-encuestas-rotulo.mp4",
		"ucn-salud": "remotion render UCN-Salud-Escolar out/sin-rotulo/ucn-salud-escolar.mp4",
		"ucn-salud-rotulo": "remotion render UCN-Salud-Escolar-Rotulo out/ucn-salud-escolar-rotulo.mp4",
		"ucn-comparador": "remotion render UCN-Comparador out/sin-rotulo/ucn-comparador.mp4",
		"ucn-comparador-rotulo": "remotion render UCN-Comparador-Rotulo out/ucn-comparador-rotulo.mp4",
		"ucn-metas": "remotion render UCN-Metas out/sin-rotulo/ucn-metas.mp4",
		"ucn-metas-rotulo": "remotion render UCN-Metas-Rotulo out/ucn-metas-rotulo.mp4",
		"ucn-misional": "remotion render UCN-Misional out/sin-rotulo/ucn-misional.mp4",
		"ucn-misional-rotulo": "remotion render UCN-Misional-Rotulo out/ucn-misional-rotulo.mp4",
		"todo-ucn": "npm run ucn-comunicados && npm run ucn-comunicados-rotulo && npm run ucn-encuestas && npm run ucn-encuestas-rotulo && npm run ucn-salud && npm run ucn-salud-rotulo && npm run ucn-comparador && npm run ucn-comparador-rotulo && npm run ucn-metas && npm run ucn-metas-rotulo && npm run ucn-misional && npm run ucn-misional-rotulo",
		"portada": "remotion render Portada out/piezas/portada.mp4",
		"tarjeta": "remotion render Tarjeta out/piezas/tarjeta.mp4",
		"cierre": "remotion render Cierre out/piezas/cierre.mp4",
		"todo-piezas": "npm run portada && npm run tarjeta && npm run cierre"
	},
	"dependencies": {
		"@remotion/cli": "^4.0.0",
		"remotion": "^4.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"typescript": "^5.6.0"
	}
}
